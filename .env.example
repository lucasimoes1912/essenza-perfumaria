# Chave de acesso do Mercado Pago (Producao ou Teste)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app > Credenciais
MP_ACCESS_TOKEN=

# URL publica do site (usada nos redirects do checkout e no webhook)
# No Railway: https://SEU-APP.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexao com o Postgres (no Railway use a referencia ${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Senha do painel administrativo (/admin)
ADMIN_PASSWORD=
